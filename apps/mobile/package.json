{
  "name": "ryntra-mobile",
  "version": "1.21.0",
  "private": true,
  "description": "Ryntra for Android — the native client of the Solana trading and strategy platform.",
  "main": "./index.js",
  "scripts": {
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "chart:check": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/chart-page.mjs --check",
    "chart:page": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/chart-page.mjs",
    "dev": "expo start --dev-client",
    "doctor": "npx -y expo-doctor@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "release:android": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/release-android.mjs",
    "release:check": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/release-check.mjs",
    "start": "expo start --dev-client",
    "test": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.mjs\"",
    "tokens:check": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-tokens.mjs --check",
    "tokens:sync": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-tokens.mjs",
    "theme:css": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/theme-css.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run theme:css -- --check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo/metro-runtime": "~57.0.5",
    "@expo/vector-icons": "^15.0.2",
    "@solana/kit": "^7.0.0",
    "@tanstack/react-query": "^5.100.14",
    "@wallet-ui/react-native-kit": "^4.2.1",
    "expo": "~57.0.6",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.5",
    "expo-dev-client": "~57.0.6",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~57.0.6",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "~4.1.16",
    "uniwind": "^1.7.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "klinecharts": "10.1.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
